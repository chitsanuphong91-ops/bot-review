# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงของคุณ (ห้ามอัปโหลด .env ขึ้น GitHub)

# Bot Token จาก https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Application (Client) ID จากหน้า General Information
CLIENT_ID=

# (ไม่บังคับ) ใส่ Guild ID เพื่อให้คำสั่ง /slash ขึ้นทันทีตอนทดสอบ (ไม่ต้องรอ global sync ~1 ชม.)
GUILD_ID=

# ห้อง (channel ID) ที่จะให้บอทโพสต์รีวิวที่ผู้ใช้ส่งเข้ามา
REVIEW_CHANNEL_ID=

# พอร์ตสำหรับ web server เล็กๆ (Render ต้องการพอร์ตเปิดไว้ ถ้าใช้ Railway จะไม่จำเป็นแต่ใส่ไว้ก็ไม่เสียหาย)
PORT=3000
